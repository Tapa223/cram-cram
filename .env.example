# ============================================================
# CRAM-CRAM Mali — configuration
# Copier ce fichier en « .env » et l'adapter. Le fichier .env
# ne doit jamais être versionné (il est exclu par .gitignore).
# ============================================================

# production | local
APP_ENV=local
# true uniquement en local : affiche le détail des erreurs. Toujours false en production.
APP_DEBUG=true

# Clé secrète propre à chaque installation (64 caractères hexadécimaux).
# Pour en générer une : php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Laisser vide : le chemin est détecté automatiquement (ex. /cramcram sous XAMPP).
APP_BASE_PATH=

# Base de données (XAMPP : utilisateur root, mot de passe vide par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cramcram
DB_USER=root
DB_PASS=

# Sécurité
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
