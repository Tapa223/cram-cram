# Fichiers téléversés : aucune exécution de script, aucun listing.
Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
